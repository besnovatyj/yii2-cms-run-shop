{
  "name": "besnovatyj/yii2-cms-run-shop",
  "description": "Модуль магазина RUnIsLife для Yii2 CMS",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\RunShop\\Module",
    "moduleId": "RunShop",
    "bootstrap": "Besnovatyj\\RunShop\\Bootstrap",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "RunShop",
    "cms"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.2",
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "besnovatyj/yii2-cms-user": "^1.0",
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0",
    "besnovatyj/yii2-cms-meta": "^1.0",
    "besnovatyj/yii2-cms-forms": "^1.0",
    "besnovatyj/yii2-cms-upload": "^1.0",
    "besnovatyj/yii2-cms-images": "^1.0",
    "besnovatyj/yii2-cms-validators": "^1.0",
    "besnovatyj/yii2-cms-backend-widgets": "^1.0",
    "besnovatyj/yii2-cms-switcher-column": "^1.0",
    "besnovatyj/yii2-cms-pessimistic-lock-behavior": "^1.0",
    "besnovatyj/yii2-cms-tree-manager": "^1.0",
    "besnovatyj/yii2-cms-smart-domain-events": "^1.0",
    "yoomoney/yookassa-sdk-php": "^3.14.0",
    "besnovatyj/yii2-cms-editor": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\RunShop\\": "src/"
    }
  }
}
